{
  "version": 3,
  "description": "Astrsomn 焦点布局 - 12列完美对称模式",
  "layout": {
    "cols": 12,
    "rowHeight": 100,
    "gap": 16,
    "maxRows": 6
  },
  "modules": [
    {
      "kind": "AiAgent",
      "description": "核心主体：居中，占据 8/12 宽度",
      "x": 2,
      "y": 0,
      "w": 8,
      "h": 4,
      "minW": 6,
      "minH": 3
    },
    {
      "kind": "AiModel",
      "route": "/admin/models",
      "description": "左侧翼：模型支撑",
      "x": 0,
      "y": 0,
      "w": 2,
      "h": 2
    },
    {
      "kind": "AiTool",
      "route": "/admin/tools",
      "description": "右侧翼：工具支撑",
      "x": 10,
      "y": 0,
      "w": 2,
      "h": 2
    },
    {
      "kind": "AiPrompt",
      "route": "/admin/prompts",
      "description": "左侧输入：提示词",
      "x": 0,
      "y": 2,
      "w": 2,
      "h": 2
    },
    {
      "kind": "AiMcp",
      "route": "/admin/mcp",
      "description": "右侧连接：MCP协议",
      "x": 10,
      "y": 2,
      "w": 2,
      "h": 2
    },
    {
      "kind": "AiAccount",
      "route": "/admin/ai-account",
      "x": 0,
      "y": 4,
      "w": 3,
      "h": 1
    },
    {
      "kind": "AiTemplate",
      "route": "/admin/templates",
      "x": 9,
      "y": 4,
      "w": 3,
      "h": 1
    },
    {
      "kind": "TraceInsight",
      "route": "/admin/tracing",
      "x": 3,
      "y": 4,
      "w": 2,
      "h": 1
    },
    {
      "kind": "SystemUser",
      "route": "/admin/users",
      "x": 5,
      "y": 4,
      "w": 2,
      "h": 1
    },
    {
      "kind": "SystemEnv",
      "route": "/admin/env",
      "x": 7,
      "y": 4,
      "w": 2,
      "h": 1
    },
    {
      "kind": "SecurityPolicy",
      "route": "/admin/security",
      "x": 0,
      "y": 5,
      "w": 4,
      "h": 1
    },
    {
      "kind": "SystemConfig",
      "route": "/admin/system-config",
      "x": 4,
      "y": 5,
      "w": 4,
      "h": 1
    },
    {
      "kind": "SystemExtension",
      "route": "/admin/system-config/system-extension",
      "x": 8,
      "y": 5,
      "w": 4,
      "h": 1
    },
    {
      "kind": "ConsoleResourceLibrary",
      "route": "/admin/resource-library",
      "x": 0,
      "y": 6,
      "w": 12,
      "h": 1
    }
  ]
}