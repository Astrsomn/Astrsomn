{
  "version": 3,
  "description": "Astrsomn 焦点布局 - Agent居中对称模式",
  "layout": {
    "cols": 12,
    "rowHeight": 100,
    "gap": 16,
    "maxRows": 6
  },
  "modules": [

    {
      "kind": "AiModel",
      "route": "/admin/models",
      "x": 0, "y": 0, "w": 3, "h": 2
    },
    {
      "kind": "AiAgent",
      "description": "核心主体：居中，不占满全宽（6/12）",
      "x": 3, "y": 0, "w": 6, "h": 4,
      "minW": 6, "minH": 3
    },

    {
      "kind": "AiTool",
      "route": "/admin/tools",
      "x": 9, "y": 2, "w": 3, "h": 2
    },


    {
      "kind": "AiPrompt",
      "route": "/admin/prompts",
      "x": 0, "y": 4, "w": 3, "h": 1
    },
    {
      "kind": "AiMcp",
      "route": "/admin/mcp",
      "x": 3, "y": 4, "w": 3, "h": 1
    },
    {
      "kind": "AiAccount",
      "route": "/admin/ai-account",
      "x": 6, "y": 4, "w": 3, "h": 1
    },
    {
      "kind": "AiTemplate",
      "route": "/admin/templates",
      "x": 9, "y": 4, "w": 3, "h": 1
    },
    {
      "kind": "TraceInsight",
      "route": "/admin/tracing",
      "x": 0, "y": 5, "w": 2, "h": 1
    },
    {
      "kind": "SystemUser",
      "route": "/admin/users",
      "x": 6, "y": 5, "w": 2, "h": 1
    },
    {
      "kind": "SystemEnv",
      "route": "/admin/env",
      "x": 8, "y": 5, "w": 2, "h": 1
    },
    {
      "kind": "SecurityPolicy",
      "route": "/admin/security",
      "x": 10, "y": 5, "w": 2, "h": 1
    },

    {
      "kind": "SystemConfig",
      "route": "/admin/system-config",
      "x": 0, "y": 6, "w": 3, "h": 1
    },
    {
      "kind": "SystemExtension",
      "route": "/admin/system-config/system-extension",
      "x": 3, "y": 6, "w": 3, "h": 1
    },
    {
      "kind": "ConsoleResourceLibrary",
      "route": "/admin/resource-library",
      "x": 6, "y": 6, "w": 6, "h": 1
    }
  ]
}