# ============================================================================
# Astrsomn Launcher Configuration
# ============================================================================
# This file is read by start.bat / start.sh at launch time.
# Edit the values below to match your environment, then start the server.
# ============================================================================

# Java installation directory (leave empty to use the java on your PATH)
# Example: JAVA_HOME=C:\Program Files\Java\jdk-17
# Example: JAVA_HOME=/usr/lib/jvm/jdk-17
JAVA_HOME=

# JVM options (memory, encoding, etc.)
JAVA_OPTS=-Xms256m -Xmx1024m -Dfile.encoding=UTF-8
