<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.astrsomn.starter.runtime.mapper.AiTraceLogMapper">

    <select id="queryPage" resultType="com.astrsomn.api.runtime.common.dto.tracelog.AiTraceLogResponseDTO">
        SELECT
            *
        FROM
            `AI_TRACE_LOG`
        WHERE
            deleted = 0
        <if test="req != null and req.traceId != null and req.traceId != ''">
            AND TRACE_ID = #{req.traceId}
        </if>
        <if test="req != null and req.conversationId != null">
            AND CONVERSATION_ID = #{req.conversationId}
        </if>
        <if test="req != null and req.agentId != null">
            AND AGENT_ID = #{req.agentId}
        </if>
        <if test="req != null and req.instanceId != null">
            AND INSTANCE_ID = #{req.instanceId}
        </if>
        <if test="req != null and req.promptId != null">
            AND PROMPT_ID = #{req.promptId}
        </if>
        <if test="req != null and req.agentKey != null and req.agentKey != ''">
            AND AGENT_KEY = #{req.agentKey}
        </if>
        <if test="req != null and req.nodeType != null and req.nodeType != ''">
            AND NODE_TYPE = #{req.nodeType}
        </if>
        <if test="req != null and req.status != null and req.status != ''">
            AND STATUS = #{req.status}
        </if>
        <if test="req != null and req.envCode != null and req.envCode != ''">
            AND ENV_CODE = #{req.envCode}
        </if>
        <if test="req != null and req.createUser != null and req.createUser != ''">
            AND CREATE_USER = #{req.createUser}
        </if>
        ORDER BY
            CREATE_TIME DESC
    </select>

</mapper>
