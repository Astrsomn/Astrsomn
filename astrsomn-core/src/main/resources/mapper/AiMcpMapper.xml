<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.astrsomn.core.mapper.AiMcpMapper">

    <select id="queryPage" resultType="org.astrsomn.core.common.dto.mcp.AiMcpResponseDTO">
        SELECT
        amc.*
        FROM
        AI_MCP amc
        WHERE
        1=1
        <if test="req != null and req.envCode != null and req.envCode != ''">
            AND amc.env_code = #{req.envCode}
        </if>
        <if test="req != null and req.mcpKey != null and req.mcpKey != ''">
            AND amc.mcp_key = #{req.mcpKey}
        </if>
        <if test="req != null and req.type != null and req.type != ''">
            AND amc.type = #{req.type}
        </if>
        <if test="req != null and req.enabled != null">
            AND amc.enabled = #{req.enabled}
        </if>
        ORDER BY
        amc.create_time DESC
    </select>

</mapper>