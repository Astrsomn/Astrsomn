<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.astrsomn.core.mapper.AiAgentMapper">


    <select id="queryPage" resultType="org.astrsomn.core.common.dto.agent.AiAgentResponseDTO">
        SELECT
        aa.*
        FROM
        AI_AGENT aa
        ORDER BY
        aa.create_time DESC
    </select>
</mapper>