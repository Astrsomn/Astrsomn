<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.astrsomn.core.mapper.SystemEnvMapper">

    <select id="queryPage" resultType="org.astrsomn.core.common.dto.env.SystemEnvResponseDTO">
        SELECT
        se.*
        FROM
        SYSTEM_ENV se
        WHERE
        1=1
        <if test="req != null and req.envName != null and req.envName != ''">
            AND se.env_name LIKE CONCAT('%', #{req.envName}, '%')
        </if>
        <if test="req != null and req.envCode != null and req.envCode != ''">
            AND se.env_code = #{req.envCode}
        </if>
        ORDER BY
        se.create_time DESC
    </select>

</mapper>