<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.astrsomn.core.mapper.AiInstanceMapper">

    <select id="queryPage" resultType="org.astrsomn.core.common.dto.instance.AiInstanceResponseDTO">
        SELECT
        ai.*
        FROM
        AI_INSTANCE ai
        WHERE
        (ai.deleted = 0 OR ai.deleted IS NULL)
        <if test="req != null and req.instanceKey != null and req.instanceKey != ''">
            AND ai.instance_key LIKE CONCAT('%', #{req.instanceKey}, '%')
        </if>
        <if test="req != null and req.status != null and req.status != ''">
            AND ai.status = #{req.status}
        </if>
        <if test="req != null and req.envCode != null and req.envCode != ''">
            AND ai.env_code = #{req.envCode}
        </if>
        ORDER BY
        ai.create_time DESC
    </select>
</mapper>
