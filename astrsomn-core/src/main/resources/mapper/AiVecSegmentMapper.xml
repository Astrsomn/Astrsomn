<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.astrsomn.core.mapper.AiVecSegmentMapper">

    <select id="queryPage" resultType="org.astrsomn.core.common.dto.vecsegment.AiVecSegmentResponseDTO">
        SELECT
            *
        FROM
            `AI_VEC_SEGMENT`
        WHERE
            deleted = 0
        <if test="req != null and req.docId != null">
            AND DOC_ID = #{req.docId}
        </if>
        <if test="req != null and req.collectionId != null">
            AND COLLECTION_ID = #{req.collectionId}
        </if>
        <if test="req != null and req.vectorId != null and req.vectorId != ''">
            AND VECTOR_ID = #{req.vectorId}
        </if>
        <if test="req != null and req.envCode != null and req.envCode != ''">
            AND ENV_CODE = #{req.envCode}
        </if>
        <if test="req != null and req.createUser != null and req.createUser != ''">
            AND CREATE_USER = #{req.createUser}
        </if>
        ORDER BY
            CREATE_TIME DESC
    </select>

</mapper>
