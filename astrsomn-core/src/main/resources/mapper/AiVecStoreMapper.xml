<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.astrsomn.core.mapper.AiVecStoreMapper">

    <select id="queryPage" resultType="org.astrsomn.core.common.dto.vecstore.AiVecStoreResponseDTO">
        SELECT
            *
        FROM
            AI_VEC_STORE
        WHERE
            deleted = 0
        <if test="req != null and req.sourceId != null">
            AND SOURCE_ID = #{req.sourceId}
        </if>
        <if test="req != null and req.collectionName != null and req.collectionName != ''">
            AND COLLECTION_NAME LIKE CONCAT('%', #{req.collectionName}, '%')
        </if>
        <if test="req != null and req.modelKey != null and req.modelKey != ''">
            AND MODEL_KEY = #{req.modelKey}
        </if>
        <if test="req != null and req.envCode != null and req.envCode != ''">
            AND ENV_CODE = #{req.envCode}
        </if>
        <if test="req != null and req.createUser != null and req.createUser != ''">
            AND CREATE_USER = #{req.createUser}
        </if>
        ORDER BY
            CREATE_TIME DESC
    </select>

</mapper>
